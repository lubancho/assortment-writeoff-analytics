# Скопируйте этот файл в .env и при желании поменяйте пароль.
# Здесь нет настоящих секретов: база локальная и содержит только синтетические данные.

POSTGRES_USER=asa
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=asa
# Порт PostgreSQL на вашем компьютере (внутри Docker база слушает 5432)
DB_PORT=5434
APP_PORT=8502
LOG_LEVEL=INFO

# Для запуска без Docker (uv run …) — адреса баз на вашем компьютере:
DATABASE_URL=postgresql://asa:change-me-local-only@localhost:5434/asa
TEST_DATABASE_URL=postgresql://asa:change-me-local-only@localhost:5434/asa_test
